{
  "name": "calmmd",
  "private": true,
  "version": "1.1.0",
  "description": "CalmMD: a calm, beautiful Markdown editor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "tauri": "tauri",
    "app:dev": "cargo run -p calmmd-gpui",
    "app:build": "cargo build --release -p calmmd-gpui",
    "site": "node scripts/build-site.mjs",
    "app:gpui": "cargo run -p calmmd-gpui",
    "app:package": "node scripts/package-gpui.mjs",
    "app:dev:legacy": "tauri dev",
    "app:build:legacy": "tauri build",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "app:mcp:headless": "cargo run -p calmmd-core --bin calmmd-mcp --"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/literata": "^5.2.5",
    "@lezer/highlight": "^1.2.1",
    "@takumi-rs/helpers": "^2.20.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.3.0",
    "pagedjs": "^0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.7",
    "takumi-pdf": "^0.20.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^5.1.0"
  }
}
